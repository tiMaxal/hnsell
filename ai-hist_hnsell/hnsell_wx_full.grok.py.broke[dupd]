for (let i = links.length - 1; i > 0; i--) {
const j = Math.floor(Math.random() * (i + 1));
[links[i], links[j]] = [links[j], links[i]];
}
marketplaceLinks.innerHTML = '';
links.forEach(link => marketplaceLinks.appendChild(link));
}
});
</script>"""
