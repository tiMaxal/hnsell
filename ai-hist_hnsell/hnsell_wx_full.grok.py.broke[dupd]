    def process_punytag(self):
        """Process Punytag Processor tab."""
        selected = self.file_listbox.GetSelections()
        if not selected:
            wx.MessageBox("No files selected", "Warning", wx.OK | wx.ICON_WARNING)
            return
        
        rename_orig = self.rename_orig_check.GetValue()
        sort_to_subdirs = self.sort_to_subdirs_check.GetValue()
        delete_orig = self.delete_orig_check.GetValue()
        
        for idx in selected:
            data = self.file_data[idx]
            filepath = data['path']
            source_type = data['source']
            if source_type == 'unknown':
                continue
            
            dir_path = os.path.dirname(filepath)
            if sort_to_subdirs:
                sub_dir = os.path.join(dir_path, source_type)
                os.makedirs(sub_dir, exist_ok=True)
                dir_path = sub_dir
            
            base_name = os.path.basename(filepath)
            timestamp = datetime.now().strftime('%Y%m%d')
            output_filename = f"{base_name.rsplit('.', 1)[0]}_{timestamp}.csv"
            output_path = os.path.join(dir_path, output_filename)
            
            try:
                if source_type == 'bob-tr':
                    self.process_bob_tr(filepath, output_path)
                elif source_type == 'nb-tr':
                    self.process_nb_tr(filepath, output_path)
                elif source_type == 'ss-tld':
                    self.process_ss_tld(filepath, output_path)
                elif source_type == 'ss-tr':
                    self.process_ss_tr(filepath, output_path)
                elif source_type == 'nb-tld':
                    self.process_nb_tld(filepath, output_path)
                # Add handling for other sources like 'fw', 'bob-tld' if needed
                
                if rename_orig:
                    os.rename(filepath, filepath + '_orig')
                if delete_orig:
                    os.remove(filepath)
            except Exception as e:
                wx.MessageBox(f"Error processing {base_name}: {str(e)}", "Error", wx.OK | wx.ICON_ERROR)
        
        wx.MessageBox("Processing completed", "Success", wx.OK | wx.ICON_INFORMATION)
    
